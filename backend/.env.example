# Copy this file to .env and fill in real values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string

# Optional — see config/settings.py for details. Leave blank to derive
# automatically from SECRET_KEY.
FIELD_ENCRYPTION_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to "postgres" for production; leave as "sqlite" for zero-config local dev.
DB_ENGINE=sqlite
DB_NAME=sbos
DB_USER=sbos
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Frontend dev server origin(s), comma-separated. Vite's default port is 5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# The frontend URL printed on receipt QR codes for verification.
FRONTEND_URL=http://localhost:5173

# --- Notifications: Gmail SMTP ---
# Gmail requires an "App Password" once 2-Step Verification is on:
# https://myaccount.google.com/apppasswords — use that, not your normal password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Notifications: WhatsApp (Meta Cloud API) ---
# Create an app at https://developers.facebook.com/apps to get these.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Truvanta's own Paystack keys (for billing businesses on paid plans) —
# can also be set later via Settings > Platform Integrations in the UI.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
