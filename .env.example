# Copy this to `.env` in the same folder as docker-compose.yml, fill
# in the values, then run: docker compose up -d

# --- Required ---
# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Database password — pick anything, Docker creates the database for you.
DB_PASSWORD=

# --- Required once you have a real domain ---
# The domain(s) people will type to reach the app, comma-separated.
# For local testing, the defaults (localhost,127.0.0.1) are fine.
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost

# --- Optional — can be set later from Settings > Platform Integrations
# in the app itself instead of here ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
